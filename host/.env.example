# Any OpenAI-compatible endpoint. Local (Ollama on your GPU):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
PLANNER_MODEL=qwen3:14b
WORKER_MODEL=qwen3:14b
# Hosted example instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
VM_MCP_URL=http://localhost:8765/mcp
MAX_STEPS_PER_SUBGOAL=15
MAX_TOKENS_PER_TASK=200000
# GUI worker (../gui_worker). It needs a vision model; its key goes in gui_worker/.env.
# The review model checks "done" and writes lessons; it must differ from GUI_MODEL.
GUI_PROVIDER=openai
GUI_MODEL=gpt-5.4-mini
GUI_REVIEW_MODEL=gpt-5.5
# 1 = the GUI worker acts on this PC's screen; 0 = it only proposes one action
GUI_EXECUTE=1
GUI_MAX_STEPS=16
GUI_TIMEOUT=240
