# Run the agent directly on this computer without starting the VM MCP server.
AGENT_MODE=local
# sandbox: default, project-local host/local_sandbox directory.
# workspace: use a dedicated existing directory you explicitly select; see README.
AGENT_SCOPE=sandbox
# Relative paths are resolved from host/. Never set this to your home directory.
AGENT_ROOT=local_sandbox

# Ollama must be running locally. Pull the model first: ollama pull qwen3:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
DEFAULT_MODEL=qwen3:8b
PLANNER_MODEL=qwen3:8b
WORKER_MODEL=qwen3:8b
CRITIC_MODEL=qwen3:8b
LLM_TEMPERATURE=0
# For Ollama's OpenAI-compatible endpoint, reasoning_effort=none disables
# Qwen3 thinking. Set true to leave the model's thinking behavior unchanged.
OLLAMA_THINKING=false

# Use AGENT_MODE=vm and set VM_MCP_URL when switching back to the Windows VM.
VM_MCP_URL=http://localhost:8765/mcp

MAX_STEPS_PER_SUBGOAL=15
MAX_TOKENS_PER_TASK=200000
MAX_QUICK_FIXES_PER_SUBGOAL=2
